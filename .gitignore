# SECTION 3: Downloaded/Generated Data (DO NOT COMMIT)
# Raw ABIDE fMRI data
data/raw/**
data/metadata/*.feather
data/metadata/harmonized_folds_cv/*.feather
data/metadata/harmonized_folds_cv/*.pkl
data/metadata/harmonized_folds_cv/*.csv
data/metadata/*_1015.csv
!data/metadata/master_manifest_1015.csv
data/metadata/active_subject_ids.txt
data/metadata/subject_ids_1015.txt
data/metadata/download_log.csv
data/metadata/fold_unseen_site_audit.csv
data/metadata/harmonization_variance_retention.csv

# Keep small metadata files only
!data/metadata/atlas_metadata.json
!data/metadata/roi_centroids.json
!data/metadata/master_manifest.csv

# Processed data
data/processed/**
data/final/**

# SECTION 4: Model Checkpoints & Weights (DO NOT COMMIT)
models/checkpoints/**
models/**/*.pt
models/**/*.pth
# YOLO weights
yolo26n.pt
models/**/weights/*.pt
models/**/weights/*.weights
# Keep model configs
!models/**/*.yaml
!models/**/*.json
!models/README.md

# SECTION 5: Results & Generated Outputs (DO NOT COMMIT)
# Experiment runs (can be regenerated)
results/experiments/runs/**
results/experiments/training/**
results/experiments/detection/**
results/experiments/data_quality/**
# Analysis outputs (ignore all, keep summary)
results/analysis/**
!results/analysis/result_analysis_summary.json
# Subject analysis
results/subject_analysis/**
# Visualizations
results/visualizations/**
# Evaluation outputs (ignore all, keep essential)
results/evaluation/**
!results/evaluation/comprehensive_results.json
!results/evaluation/comprehensive_results.csv
!results/evaluation/config_snapshot.json
# Evaluation RG duplicates (ignore all)
results/evaluation_rg/**
# Ablation results (keep)
results/experiments/ablations/**
!results/experiments/ablations/ablation_results.csv
!results/experiments/ablations/ablation_summary.json
# Explainability outputs (ignore all, keep summary)
results/explainability/**
!results/explainability/summary.json
# Paper figures - KEEP (demonstrate project quality)
# (can be regenerated with: bash scripts/figures/generate_all.sh)

# SECTION 6: Experiment Scripts (Reference Only - IGNORE)

