# --- Python & Environments ---
**/__pycache__/
**/*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.env
build/
dist/

# --- Jupyter & Notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Data & Large Scientific Files (Global Rules) ---
*.nii
*.nii.gz
*.npy
*.mat
*.h5
*.hdf5
*.dcm
*.zip
*.tar*
*.7z

# --- Project Data Directories ---
# Ignore heavy data but keep the directory hierarchy via .gitkeep
data/raw/**
data/processed/**
data/final/**
data/images/
data/labels/
backup83/

# Metadata Exceptions: Keep critical manifests and atlas info
!data/metadata/atlas_metadata.json
!data/metadata/roi_centroids.json
!data/metadata/master_manifest.csv
!data/metadata/node_attributes_*.csv

# --- Models & Weights ---
models/**
*.pt
*.pth
*.ckpt
*.onnx
*.weights
yolo26n.pt

# Keep model configs/READMEs
!models/README.md
!models/**/*.yaml
!models/**/*.json

# --- Results & Experiment Tracking ---
runs/
mlruns/
.mlflow/
# Keep plots and summaries, ignore heavy per-subject CSVs if needed
results/**
!results/**/*.png
!results/**/*.jpg
!results/**/*.json
!results/**/README.md
!results/.gitkeep

# --- OS / IDE Junk ---
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
Thumbs.db
.AppleDouble

# --- Logs & Performance ---
logs/
*.log
*.pkl

# --- Scripts & Tools ---
# Keeping the clean script, but ignoring generated tree logs
tree.sh
tree.md

# --- Testing & Coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Misc ---
dump/