# SECTION 1: Python & Build Artifacts
**/__pycache__/
**/*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.env
build/
dist/
*.egg

# SECTION 2: Jupyter Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb
!notebooks/eda.ipynb

# SECTION 3: Data - RAW (Downloaded/Generated - DO NOT COMMIT)
# Raw fMRI data from ABIDE
data/raw/**

# Processed time series and features
data/processed/**

# YOLO training data (generated)
data/final/**

# Image labels for YOLO
data/images/
data/labels/

# Data metadata (large files - keep small config files only)
data/metadata/*.feather
data/metadata/harmonized_folds_cv/*.feather
data/metadata/harmonized_folds_cv/*.csv
data/metadata/harmonized_folds_cv/combat_model_*.pkl

# Keep only small metadata files (JSON, small CSVs, TXT)
!data/metadata/atlas_metadata.json
!data/metadata/roi_centroids.json
!data/metadata/master_manifest.csv
!data/metadata/active_subject_ids.txt
!data/metadata/subject_ids_1015.txt
!data/metadata/phenotypic_manifest_1015.csv
!data/metadata/download_log.csv
!data/metadata/fold_unseen_site_audit.csv
!data/metadata/harmonization_variance_retention.csv

# SECTION 4: Models & Checkpoints (Large - DO NOT COMMIT)
# GNN model checkpoints
models/checkpoints/**
models/**/*.pt
models/**/*.pth

# YOLO weights (downloadable artifact)
yolo26n.pt
models/**/weights/*.pt
models/**/weights/*.weights

# Keep model config files (YAML, JSON)
!models/**/*.yaml
!models/**/*.json
!models/README.md

# SECTION 5: Results & Experiment Outputs (Generated - DO NOT COMMIT)
# Full experiment runs (can be regenerated)
results/experiments/runs/**
results/experiments/training/**
results/experiments/detection/**

# Subject-level predictions
results/subject_analysis/**

# Analysis outputs (can be regenerated)
results/analysis/**

# Visualization outputs
results/visualizations/**

# Paper figures (can be regenerated)
results/paper_figures/**

# Keep only essential result summaries
!results/evaluation/comprehensive_results.json
!results/evaluation/comprehensive_results.csv
!results/evaluation/config_snapshot.json
!results/experiments/ablations/ablation_results.csv
!results/explainability/summary.json
!results/evaluation_rg/comprehensive_results.json
!results/evaluation_rg/comprehensive_results.csv
!results/evaluation_rg/config_snapshot.json
!results/evaluation_rgh/comprehensive_results.json
!results/evaluation_rgh/comprehensive_results.csv
!results/evaluation_rgh/config_snapshot.json

# SECTION 6: Experiment Scripts (Reference Only - DO NOT COMMIT)
paper/experiments/**

