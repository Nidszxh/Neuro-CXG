*.nii
*.nii.gz
*.npy
*.mat
*.h5
*.hdf5
*.dcm
*.zip
*.tar*
*.7z
*.feather
*.pkl

# SECTION 8: Temporary & Development Files (DO NOT COMMIT)
temp/
temp/**
temp/**/*

# Development patches
patch_*.py

# Documentation drafts
docs/deprecated/**
docs/archive/**

# Hash/debug files
*.backup
*.log

# Keep all workflow files for CI/CD (Right now we have none)
.github/ 

# Keep Docker configs
!Dockerfile
!configs/docker-compose.yml

# SECTION 10: OS & IDE Files (DO NOT COMMIT)
.DS_Store
.AppleDouble
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# SECTION 11: Testing & Coverage (DO NOT COMMIT)
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# SECTION 12: ML Experiment Tracking (DO NOT COMMIT)
mlruns/
.mlflow/

